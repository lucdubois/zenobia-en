#!/usr/bin/env python3
"""Build the English patch: ./build [ROM]   (Windows: python build ROM)
Writes the IPS next to the ROM, with the same name (Foo.ngc -> Foo.ips). Asks for the ROM path if it is not given."""
import os,sys,tempfile
sys.path.insert(0,os.path.join(os.path.dirname(os.path.abspath(__file__)),'tools'))
import build as pipeline
from cli import ask_path
if __name__=='__main__':
    rom=ask_path(sys.argv[1] if len(sys.argv)>1 else '')
    ips=os.path.splitext(rom)[0]+'.ips'
    with tempfile.TemporaryDirectory() as tmp:
        pipeline.build(rom,os.path.join(tmp,'patched.ngc'),ips,'out/script_sheet.tsv',quiet=True)
    print(f'Patch written: {ips}')
